# ─── Vercel (frontend) environment variables ───
# Set this in the Vercel dashboard: Project → Settings → Environment Variables.

# URL of the Pi MJPEG stream. Must be reachable from the *viewer's* browser,
# and over HTTPS (use your Cloudflare tunnel URL + /stream). Exposed to the
# browser via the NEXT_PUBLIC_ prefix. The frontend derives the Pi API base
# (for /auth and /admin/*) from this by stripping the trailing /stream.
NEXT_PUBLIC_STREAM_URL=https://your-tunnel.trycloudflare.com/stream

# NOTE: viewer passwords and the admin password now live on the PI, managed
# from /admin and stored in pi-server/config.local.json. Set their initial
# values via STREAM_PASSWORD and ADMIN_PASSWORD in pm2.config.js — not here.
