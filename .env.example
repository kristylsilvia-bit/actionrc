# ─── Vercel (frontend) environment variables ───
# Copy to .env.local for local dev, and set the same keys in the Vercel
# dashboard for production: Project → Settings → Environment Variables.

# Password gate for the stream page.
#   - Set to 0 to DISABLE the gate entirely (stream shows immediately, no prompt).
#   - Set to any other value to REQUIRE that password before the stream is shown.
STREAM_PASSWORD=changeme

# URL of the Pi MJPEG stream. Must be reachable from the *viewer's* browser.
# Exposed to the browser via the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_STREAM_URL=http://104.229.7.78:2638/stream
